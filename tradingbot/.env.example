# Binance API Keys (Required for live trading, testnet, or fetching balances)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Telegram Notifications (Optional - message @BotFather on Telegram to set up)
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
TELEGRAM_CHAT_ID=987654321

# CORS Origins (Comma-separated list of allowed frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Directory where bot configurations, live status snapshots, and logs are persisted
DATA_DIR=data
